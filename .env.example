# =============================================================================
# gameplay-content-generator — Environment configuration
# =============================================================================
# Copy to .env and adjust. All values below are defaults / placeholders.

# ── General ──────────────────────────────────────────────────────────────────
GPCG_ENV=development
GPCG_HOST=127.0.0.1
GPCG_PORT=8787
GPCG_DATA_DIR=./data
GPCG_DB_PATH=./data/gpcg.db

# ── Authentication ───────────────────────────────────────────────────────────
# JWT secret for auth tokens. Generate with: openssl rand -hex 32
GPCG_JWT_SECRET=change-me-in-production
# JWT token expiry in seconds (default: 7 days)
GPCG_JWT_EXPIRY=604800
# Admin email — this user gets admin privileges
GPCG_ADMIN_EMAIL=brunomartinsss@gmail.com

# ── Gameplay Inbox ───────────────────────────────────────────────────────────
# Where the recorder (OBS/etc) drops gameplay files. External HD.
GAMEPLAY_INBOX_DIR=/media/bruno/ToshibaHD
# Polling interval in seconds for the inbox watcher
GPCG_INBOX_POLL_INTERVAL=30
# Seconds a file must keep stable size before being considered "ready"
GPCG_INBOX_STABLE_SECONDS=10
# Minimum file size in bytes to consider a valid recording
GPCG_INBOX_MIN_SIZE_MB=5

# ── Local AI (Ollama) ────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
GPCG_LLM_MODEL=llama3.1:8b
GPCG_VLM_MODEL=gemma3:12b
GPCG_LLM_TIMEOUT=180

# ── video-generate integration ───────────────────────────────────────────────
# Absolute path to the video-generate project root
VIDEO_GENERATE_DIR=/home/bruno/Desenvolvimento/brunointegrations/video-generate
# Absolute path to the ai-media-core source root
AI_MEDIA_CORE_DIR=/home/bruno/Desenvolvimento/brunointegrations/ai-media-core/src
# Python interpreter of the video-generate venv
VIDEO_GENERATE_PYTHON=/home/bruno/Desenvolvimento/brunointegrations/video-generate/.venv/bin/python
# TTS voice reference wav (relative to VIDEO_GENERATE_DIR)
GPCG_TTS_VOICE=public/voices/bruno.wav
GPCG_TTS_LANGUAGE=pt
# Render timeout in seconds (per render)
GPCG_RENDER_TIMEOUT=3600

# ── Content defaults ─────────────────────────────────────────────────────────
GPCG_DEFAULT_FORMAT=youtube_short
GPCG_DEFAULT_TARGET_DURATION=60
GPCG_DEFAULT_VIDEO_PROFILE=reel_9_16

# ── Scene + video customization ────────────────────────────────────────────
# Target duration of each gameplay scene in seconds (0 = auto, one scene per clip)
GPCG_SCENE_DURATION=0
# Video format: "9:16", "16:9", "1:1", "4:5"
GPCG_VIDEO_FORMAT=9:16
# Subtitle customization (empty/0 = use profile defaults)
GPCG_SUBTITLE_FONT=
GPCG_SUBTITLE_FONT_SIZE=0
GPCG_SUBTITLE_COLOR=
GPCG_SUBTITLE_OUTLINE_COLOR=
GPCG_SUBTITLE_POSITION=
GPCG_SUBTITLE_CASE=
GPCG_NARRATION_MIN_CHARS=800
GPCG_NARRATION_MAX_CHARS=1000
GPCG_MAX_REPAIR_RETRIES=2

# ── Anti-plagiarism ─────────────────────────────────────────────────────────
# Max automatic rewrites when script is too similar to source documents
GPCG_MAX_ORIGINALITY_REWRITES=3
# Minimum originality score (0-100). Below this, script is rewritten.
GPCG_ORIGINALITY_THRESHOLD=70.0
# N-gram size (in words) for overlap detection. 5 = good for pt-BR.
GPCG_ORIGINALITY_NGRAM_SIZE=5

# ── Creative Engine (Qwen3-14B) ─────────────────────────────────────────────
# Master switch. When false, the pipeline runs without the creative stage
# (legacy behavior). When true, an extra `creative_engine` stage runs between
# content_planning and script, producing hooks/angles/punchlines/observations
# that feed into the script generator.
# Install the model first:  ollama pull qwen3:14b
GPCG_CREATIVE_ENGINE_ENABLED=false
# Ollama model tag. qwen3:14b ships as Q4_K_M GGUF (~9 GB) — fits 12 GB VRAM.
GPCG_CREATIVE_ENGINE_MODEL=qwen3:14b
# Sampling params. Higher temperature = more creative / less predictable.
GPCG_CREATIVE_ENGINE_TEMPERATURE=0.85
GPCG_CREATIVE_ENGINE_MAX_TOKENS=2048
# If true, a creative-engine failure logs an error and the pipeline continues
# without creative material (legacy script path). If false, the job fails.
GPCG_CREATIVE_ENGINE_FALLBACK=true
# Default style preset: humor, absurd, sarcastic, storytelling, curiosity,
# nostalgia, dark_humor, high_energy. Can be overridden per-job via API/CLI.
GPCG_CREATIVE_ENGINE_STYLE=humor

# ── Editorial Pipeline (NEW) ─────────────────────────────────────────────────
# Master switch for the editorial_planning stage. When true, an
# EditorialPlanner produces a VideoCreativePlan before script generation
# that decides video type, central idea, narrative beats, tone, humor plan,
# and model recommendation (gemma3 vs qwen3).
GPCG_EDITORIAL_PLANNING_ENABLED=true
# LLM temperature for the planner (lower = more deterministic editorial decisions)
GPCG_EDITORIAL_TEMPERATURE=0.4
# Max tokens for the planner response
GPCG_EDITORIAL_MAX_TOKENS=2048
# Model tags for plan-recommended models
GPCG_EDITORIAL_GEMMA_MODEL=gemma3:12b
GPCG_EDITORIAL_QWEN_MODEL=qwen3:14b

# Master switch for the script_review stage. When true, a ScriptCritic
# evaluates the script and may trigger revisions (up to max_revisions).
GPCG_SCRIPT_CRITIC_ENABLED=true
# Max revision attempts (0 = review only, no revisions; 3 = up to 3 rewrites)
GPCG_SCRIPT_CRITIC_MAX_REVISIONS=3
# LLM model for the critic (empty = use default text model)
GPCG_SCRIPT_CRITIC_MODEL=
# Temperature for the critic (low = more consistent evaluations)
GPCG_SCRIPT_CRITIC_TEMPERATURE=0.3

# ── Gameplay Understanding (NEW) ─────────────────────────────────────────────
# Master switch for gameplay analysis. When true, the GameplayAnalyzer can
# be run via `gpcg analyze-gameplay` to build the semantic event index.
GPCG_GAMEPLAY_ANALYSIS_ENABLED=true
# VLM model for frame analysis (gemma3:12b supports vision via Ollama)
GPCG_GAMEPLAY_VISION_MODEL=gemma3:12b
# ASR model size for faster-whisper (tiny, base, small, medium, large-v3)
GPCG_GAMEPLAY_ASR_MODEL=large-v3
# ASR device and compute type (cuda/float16 for GPU, cpu/int8 for CPU)
GPCG_GAMEPLAY_ASR_DEVICE=cuda
GPCG_GAMEPLAY_ASR_COMPUTE_TYPE=float16
# Coarse pass: segment duration in seconds (1 frame per segment)
GPCG_GAMEPLAY_COARSE_SEGMENT_SEC=30.0
# Refinement: frame interval in seconds for high-activity zones
GPCG_GAMEPLAY_REFINE_INTERVAL_SEC=3.0
# Ultra-refinement: frame interval for very high activity zones
GPCG_GAMEPLAY_ULTRA_REFINE_INTERVAL_SEC=1.5
# Activity level thresholds (0-1) for triggering refinement
GPCG_GAMEPLAY_ACTIVITY_THRESHOLD=0.5
GPCG_GAMEPLAY_HIGH_ACTIVITY_THRESHOLD=0.75
# Minimum interesting score for an event to be considered "interesting"
GPCG_GAMEPLAY_INTERESTING_THRESHOLD=0.4
# VLM batch size (frames per VLM call during refinement)
GPCG_GAMEPLAY_VLM_BATCH_SIZE=4
# Analysis version (for reprocessing detection)
GPCG_GAMEPLAY_ANALYSIS_VERSION=v1

# ── Worker ───────────────────────────────────────────────────────────────────
GPCG_WORKER_POLL_INTERVAL=5
GPCG_WORKER_CONCURRENCY=1

# ── YouTube Upload (google-integration service) ──────────────────────────────
# Master switch for automatic YouTube upload after QA passes.
GPCG_YOUTUBE_UPLOAD_ENABLED=false
# Base URL of the google-integration service.
GPCG_GOOGLE_INTEGRATION_URL=http://localhost:3200
# Internal API secret (must match INTERNAL_API_SECRET in google-integration .env).
GPCG_GOOGLE_INTEGRATION_SECRET=
# User ID in the google-integration DB (4 = brunointegrations admin).
GPCG_YOUTUBE_USER_ID=4
# Privacy: public | private | unlisted (use unlisted for testing).
GPCG_YOUTUBE_PRIVACY=unlisted
# YouTube category ID (20 = Gaming, 22 = People & Blogs).
GPCG_YOUTUBE_CATEGORY_ID=20
# Default tags (comma-separated, appended to plan-derived tags).
GPCG_YOUTUBE_DEFAULT_TAGS=gameplay,curiosidades,gaming

# ── Metadata Generation (LLM-powered social metadata for YouTube uploads) ──
# When true, generates optimized title/description/tags via LLM before upload.
GPCG_METADATA_GENERATION_ENABLED=true
# LLM model for metadata generation (Ollama).
GPCG_METADATA_LLM_MODEL=llama3.1:8b
