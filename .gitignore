# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Testing / linting
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environment
.env
.env.prod
.env.local

# Data (keep dir structure via .gitkeep, ignore contents)
# Symlinks to HD are tracked (so the structure is preserved in the repo)
data/inbox/*
!data/inbox
!data/inbox/.gitkeep
data/videos/*
!data/videos
!data/videos/.gitkeep
data/docs/*
!data/docs/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/jobs/*
!data/jobs
!data/jobs/.gitkeep
data/gameplay_analysis/*
!data/gameplay_analysis
data/voices/*
!data/voices
*.db
*.db-journal
*.sqlite
*.sqlite-journal

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Logs
*.log
logs/

# Model weights
yolov8m.pt
*.pt
*.onnx

# Devin temp files
.devin/

# Data root (keep structure, ignore contents)
# These are symlinks to HD on the local PC — don't commit them
data/gameplays/
data/gameplay_analysis
data/voices
data/gpcg.db
data/*.db


# Cross-platform verification state (deploy)
.cross-platform-state

# Mobile app distribution (APK + metadata, uploaded by deploy)
data/app/
